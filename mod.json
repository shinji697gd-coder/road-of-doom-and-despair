{
  "geode": "5.11.2",
  "gd": {
    "win": "2.2081"
  },
  "id": "gayan.road-of-doom",
  "name": "Road of Doom and Despair",
  "version": "v1.0.0-beta.2",
  "developer": "Gayan",
  "description": "Personal training roadmap: 75 levels, native VIEW, local progress, notes, runs and startpos markers.",
  "tags": [
    "interface",
    "utility"
  ],
  "dependencies": {
    "geode.node-ids": ">=v1.9.0"
  },
  "settings": {
    "safe-mode": {
      "type": "bool",
      "name": "Safe Mode",
      "default": true
    },
    "auto-sync-progress": {
      "type": "bool",
      "name": "Read GD progress",
      "default": true
    },
    "diagnostic-logging": {
      "type": "bool",
      "name": "Diagnostic logs",
      "default": true
    }
  }
}
