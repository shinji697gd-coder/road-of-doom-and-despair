{
  "geode": "5.11.2",
  "gd": {
    "win": "2.2081"
  },
  "id": "gayan.road-of-doom",
  "name": "Road of Doom and Despair",
  "version": "v1.0.0-beta.3",
  "developer": "Gayan",
  "description": "Parcours personnel de 75 niveaux : VIEW, progression locale, notes, runs et startpos.",
  "tags": [
    "interface",
    "utility"
  ],
  "dependencies": {
    "geode.node-ids": ">=v1.9.0"
  },
  "settings": {
    "safe-mode": {
      "type": "bool",
      "name": "Mode securise",
      "default": true
    },
    "auto-sync-progress": {
      "type": "bool",
      "name": "Lire la progression GD",
      "default": true
    },
    "diagnostic-logging": {
      "type": "bool",
      "name": "Logs de diagnostic",
      "default": true
    }
  }
}
